    nc_out.createDimension("hydro", 5)

    # Variables simples
    nc_out.createVariable("time", "f8", ("time",))[:] = time[:jsel]
    nc_out.createVariable("col", "i4", ("col",))[:] = np.arange(ncol)
    nc_out.createVariable("level", "i4", ("level",))[:] = Alt
